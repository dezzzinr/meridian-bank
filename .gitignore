# TypeScript
*.tsbuildinfo

# Drizzle generated artifacts
/drizzle

# OS / editor files
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# Vercel
.vercel

# Misc
*.local
/artifacts/
/playwright-report/
/test-results/
